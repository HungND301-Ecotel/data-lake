# ⚠️ File này KHÔNG được dùng trực tiếp trong Docker build.
# Docker build sẽ tự copy file tenants/{TENANT}.env thành .env
# theo ARG TENANT trong Dockerfile.
#
# File này chỉ dùng khi chạy: vite build --mode production (ngoài Docker)
# Khi đó, copy tenant tương ứng vào đây trước khi build:
#   cp tenants/deonaicocsau.env .env.production
#
# Xem: fe-modul-report/tenants/ để chọn tenant

VITE_TENANT=default
VITE_APP_TITLE=Hệ thống báo cáo
VITE_PRIMARY_COLOR=#1a8649
VITE_PRIMARY_DARK=#0a5232
VITE_API=http://localhost:8080/api
VITE_COMPANY_NAME=KHO DỮ LIỆU TẬP TRUNG
VITE_HOTLINE=000000000
VITE_EMAIL=0000000000000
VITE_COPYRIGHT=© 2024 Ecotel. All rights reserved.
VITE_LOGO_FILE=logo-company.png
VITE_BANNER_FILE=background.png