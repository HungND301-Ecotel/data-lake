# ============================================================
# Tenant: Uông Bí - Local deploy env
# ============================================================
# File này dùng cho deploy local (JAR + npm, không dùng Docker CI/CD)
# Uông Bí chạy BE bằng JAR và FE bằng npm run serve hoặc serve -s dist
# ============================================================

TENANT=uongbi

# Docker registry (nếu cần build image để chạy local bằng docker)
REGISTRY=hungnd301
VERSION=latest

# Ports (cho trường hợp chạy local bằng docker-compose)
PROXY_PORT=6363
BACKEND_PORT=8484
PGADMIN_PORT=5051

# Volume paths (chỉnh theo đường dẫn máy local Uông Bí)
POSTGRES_VOLUME_PATH=/mnt/hdd/uongbi_report_postgres_data
PGADMIN_VOLUME_PATH=/mnt/hdd/uongbi_report_pgadmin_data

PGADMIN_DEFAULT_EMAIL=pgadmin@pgadmin.org
PGADMIN_DEFAULT_PASSWORD=admin
