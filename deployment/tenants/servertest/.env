# ============================================================
# Tenant: servertest - Môi trường Test (Server 118)
# ============================================================
# File này được copy lên server bởi CI/CD và đọc bởi docker-compose
# KHÔNG commit thông tin nhạy cảm thật vào đây - dùng GitHub Secrets
# ============================================================

# Tên tenant - dùng làm prefix cho tên container/image/volume
TENANT=servertest

# Docker registry
REGISTRY=hungnd301

# Image version (được set tự động bởi CI/CD qua Makefile)
VERSION=latest

# Ports expose ra host
# Port 1144 đã được mở trên server 118 để test
PROXY_PORT=1144
PGADMIN_PORT=1145

# BACKEND_PORT không còn dùng nữa - BE không expose port ra ngoài.
# BE chỉ accessible qua Nginx reverse proxy (backnet nội bộ Docker).
# BACKEND_PORT=

# Volume paths trên server (thư mục phải tồn tại trước khi deploy)
POSTGRES_VOLUME_PATH=/mnt/hdd/serverTest_report_postgres_data
PGADMIN_VOLUME_PATH=/mnt/hdd/serverTest_report_pgadmin_data

# PgAdmin (có thể để mặc định)
PGADMIN_DEFAULT_EMAIL=pgadmin@pgadmin.org
PGADMIN_DEFAULT_PASSWORD=admin
