# ============================================================
# Tenant: Đèo Nai Cọc Sáu - Staging env
# ============================================================
# File này được copy lên server bởi CI/CD và đọc bởi docker-compose
# KHÔNG commit thông tin nhạy cảm thật vào đây - dùng GitHub Secrets
# ============================================================

# Tên tenant - dùng làm prefix cho tên container/image/volume
TENANT=deonaicocsau

# Docker registry
REGISTRY=hungnd301

# Image version (được set tự động bởi CI/CD qua Makefile)
VERSION=latest

# Ports expose ra host (chỉnh sửa nếu bị conflict với service khác trên server)
PROXY_PORT=1303
BACKEND_PORT=3611
PGADMIN_PORT=3603

# Volume paths trên server (thư mục phải tồn tại trước khi deploy)
POSTGRES_VOLUME_PATH=/mnt/hdd/deonaicocsau_report_postgres_data
PGADMIN_VOLUME_PATH=/mnt/hdd/deonaicocsau_report_pgadmin_data

# PgAdmin (có thể để mặc định)
PGADMIN_DEFAULT_EMAIL=pgadmin@pgadmin.org
PGADMIN_DEFAULT_PASSWORD=admin
